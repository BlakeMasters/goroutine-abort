+// prepareGoroutineAbortAtAsyncSafePoint runs before asyncPreempt2 moves any
+// register or scheduler state onto the target G. isAsyncSafePoint has already
+// excluded runtime, reflect, assembly, unsafe compiler points, runtime locks,
+// stack exhaustion, and non-Go code.
+//
+//go:nosplit
+//go:nowritebarrierrec
+func prepareGoroutineAbortAtAsyncSafePoint() {
+	gp := getg()
+	for {
+		request := gp.abortRequest.Load()
+		goid, mode := decodeGoroutineAbort(request)
+		if goid != gp.goid {
+			return
+		}
+		switch mode {
+		case GoroutineAbortHard:
+			if !gp.abortRequest.CompareAndSwap(request, 0) {
+				continue
+			}
+			// Destruction is safe for runtime bookkeeping here because the
+			// interrupted instruction belongs to ordinary user Go code and
+			// asyncPreempt2 has not yet entered scheduler or xreg custody.
+			// User locks and invariants remain deliberately unprotected.
+			mcall(goexit0)
+			throw("hard goroutine abort returned")
+		case GoroutineAbortGraceful:
+			ready, _ := encodeGoroutineAbort(goid, goroutineAbortGracefulReady)
+			if gp.abortRequest.CompareAndSwap(request, ready) {
+				return
+			}
+		case goroutineAbortGracefulReady, goroutineAbortNone:
+			return
+		default:
+			throw("invalid goroutine abort mode")
+		}
+	}
+}
+
+// prepareGoroutineAbortAtScheduler never destroys a G merely because it was
+// made runnable. Such a G may still need to finish channel, timer, syscall, or
+// runtime bookkeeping. Only a graceful request already certified by the
+// async user-code gate can be injected here. All other requests are re-armed.
+func prepareGoroutineAbortAtScheduler(gp *g) {
+	request := gp.abortRequest.Load()
+	goid, mode := decodeGoroutineAbort(request)
+	if goid != gp.goid {
+		return
+	}
+	if mode == goroutineAbortGracefulReady {
+		if gp.abortRequest.CompareAndSwap(request, 0) {
+			xRegDiscard(gp)
+			prepareGracefulGoroutineAbort(gp)
+		}
+		return
+	}
+	if mode != GoroutineAbortGraceful && mode != GoroutineAbortHard {
+		throw("invalid goroutine abort mode")
+	}
+	gp.preempt = true
+	gp.stackguard0 = stackPreempt
+	if pp := gp.m.p.ptr(); pp != nil {
+		pp.preempt = true
+	}
+}
