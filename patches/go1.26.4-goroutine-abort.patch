diff --git a/src/runtime/goroutine_abort.go b/src/runtime/goroutine_abort.go
new file mode 100644
--- /dev/null
+++ b/src/runtime/goroutine_abort.go
@@ -0,0 +1,143 @@
+// Copyright 2026 The go-goroutine-abort authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the accompanying laboratory repository.
+
+package runtime
+
+import (
+	"internal/abi"
+	"unsafe"
+)
+
+// GoroutineAbortMode controls how a requested goroutine abort is completed.
+// This API is experimental and exists only in the laboratory runtime fork.
+type GoroutineAbortMode uint8
+
+const (
+	goroutineAbortNone GoroutineAbortMode = iota
+
+	// GoroutineAbortGraceful injects Goexit at the next scheduler handoff.
+	// Defers run and can delay or defeat termination.
+	GoroutineAbortGraceful
+
+	// GoroutineAbortHard destroys the goroutine at the next scheduler
+	// handoff. Defers do not run. Locks and application invariants can be
+	// permanently stranded.
+	GoroutineAbortHard
+)
+
+const goroutineAbortModeBits = 2
+
+// GoroutineHandle is an opaque identity for one incarnation of a goroutine.
+// A recycled runtime g cannot be targeted through an older handle.
+type GoroutineHandle struct {
+	gp   *g
+	goid uint64
+}
+
+// CurrentGoroutine returns a handle for the calling goroutine.
+func CurrentGoroutine() GoroutineHandle {
+	gp := getg()
+	if gp == nil || gp.goid == 0 || gp.m == nil || gp == gp.m.g0 || gp == gp.m.gsignal {
+		return GoroutineHandle{}
+	}
+	return GoroutineHandle{gp: gp, goid: gp.goid}
+}
+
+// Valid reports whether h still identifies its original live goroutine.
+func (h GoroutineHandle) Valid() bool {
+	gp := h.gp
+	if gp == nil || h.goid == 0 || gp.goid != h.goid {
+		return false
+	}
+	return readgstatus(gp)&^_Gscan != _Gdead
+}
+
+// Abort requests termination of h at its next scheduler handoff.
+//
+// A true result means only that the request was attached to the matching
+// goroutine incarnation. A goroutine blocked indefinitely outside a runnable
+// Go safe point may never complete the request. Call Valid to observe eventual
+// termination. Abort rejects the calling goroutine and runtime system
+// goroutines.
+func (h GoroutineHandle) Abort(mode GoroutineAbortMode) bool {
+	if mode != GoroutineAbortGraceful && mode != GoroutineAbortHard {
+		return false
+	}
+	gp := h.gp
+	if gp == nil || h.goid == 0 || gp == getg() || gp.goid != h.goid {
+		return false
+	}
+	if readgstatus(gp)&^_Gscan == _Gdead || isSystemGoroutine(gp, false) {
+		return false
+	}
+
+	request, ok := encodeGoroutineAbort(h.goid, mode)
+	if !ok {
+		return false
+	}
+	for {
+		current := gp.abortRequest.Load()
+		currentGoid, currentMode := decodeGoroutineAbort(current)
+		if currentGoid == h.goid && currentMode == GoroutineAbortHard {
+			break
+		}
+		if gp.abortRequest.CompareAndSwap(current, request) {
+			break
+		}
+	}
+
+	if gp.goid != h.goid || readgstatus(gp)&^_Gscan == _Gdead {
+		return false
+	}
+	requestGoroutineAbortPreemption(gp)
+	return true
+}
+
+func encodeGoroutineAbort(goid uint64, mode GoroutineAbortMode) (uint64, bool) {
+	if goid == 0 || goid > ^uint64(0)>>goroutineAbortModeBits {
+		return 0, false
+	}
+	return goid<<goroutineAbortModeBits | uint64(mode), true
+}
+
+func decodeGoroutineAbort(request uint64) (uint64, GoroutineAbortMode) {
+	return request >> goroutineAbortModeBits, GoroutineAbortMode(request & (1<<goroutineAbortModeBits - 1))
+}
+
+func requestGoroutineAbortPreemption(gp *g) {
+	gp.preempt = true
+	gp.stackguard0 = stackPreempt
+	mp := gp.m
+	if mp == nil || mp == getg().m {
+		return
+	}
+	if pp := mp.p.ptr(); pp != nil {
+		pp.preempt = true
+	}
+	if preemptMSupported && debug.asyncpreemptoff == 0 {
+		preemptM(mp)
+	}
+}
+
+func consumeGoroutineAbort(gp *g) GoroutineAbortMode {
+	for {
+		request := gp.abortRequest.Load()
+		goid, mode := decodeGoroutineAbort(request)
+		if goid != gp.goid {
+			return goroutineAbortNone
+		}
+		if gp.abortRequest.CompareAndSwap(request, 0) {
+			return mode
+		}
+	}
+}
+
+func prepareGracefulGoroutineAbort(gp *g) {
+	pc := abi.FuncPCABIInternal(goroutineAbortGoexit)
+	gostartcall(&gp.sched, unsafe.Pointer(pc), nil)
+}
+
+func goroutineAbortGoexit() {
+	Goexit()
+}
