+func clearGoroutineAbortRequest(gp *g) {
+	if gp.abortRequest.Swap(0) != 0 {
+		finishGoroutineAbortRequest()
+	}
+}
+
+func finishGoroutineAbortRequest() {
+	if goroutineAbortPending.Add(-1) < 0 {
+		throw("negative pending goroutine abort count")
+	}
+}
+
+// preemptPendingGoroutineAbort is called by sysmon for running Ps while at
+// least one abort request exists. It retries the ordinary async-preemption
+// signal until the target is caught at a user-code safe point. This avoids a
+// scan of all Gs and adds only one atomic load to an idle sysmon iteration.
+func preemptPendingGoroutineAbort(pp *p) bool {
+	mp := pp.m.ptr()
+	if mp == nil || mp == getg().m {
+		return false
+	}
+	gp := mp.curg
+	if gp == nil || gp == mp.g0 {
+		return false
+	}
+	request := gp.abortRequest.Load()
+	goid, mode := decodeGoroutineAbort(request)
+	if goid != gp.goid || (mode != GoroutineAbortGraceful && mode != GoroutineAbortHard) {
+		return false
+	}
+	return preemptone(pp)
+}
